PORT=3000
# Optional TMDB API read access token for poster/metadata enrichment
# Fallback to local SQLite catalog runs automatically if omitted
TMDB_TOKEN=

# Secret key for JWT auth tokens (change this to a secure random string)
JWT_SECRET=your_jwt_secret_key_here

# Path to persistent database (defaults to cache/auth.db if omitted)
# AUTH_DB_PATH=/app/cache/auth.db

# Cloudflare Turnstile bot protection (optional; leave empty to disable)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Outgoing proxies (comma-separated HTTP/HTTPS/SOCKS5 proxy URLs)
PROXIES=

# Comma-separated list of providers/VODs to route through proxy (e.g. ashdi,tortuga,uaserials or * for all)
PROXIED_PROVIDERS=ashdi,tortuga

# Minimum cooldown time in hours before /v1/refresh/:id can be called for a media item (default: 2)
REFRESH_COOLDOWN_HOURS=2

# UaKinoAX (uakino.ax) provider strategy: auto | web | lampa (default: auto)
# auto tries the web API first (ashdi iframe) and falls back to the lampa proxy re-stream
UAKINO_AX_API=auto

# Optional stable device/session id for the uakino.ax lampa API (param s)
# UAKINO_AX_DEVICE_ID=

# Telegram Bot verification token & username (for 1-account-per-telegram registration)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=uafilms_verif_bot

# Fail2Ban IP Auto-Ban parameters
# Enable or disable auto-ban (default: true)
AUTOBAN_ENABLED=true
# Number of 429 rate limit violations before IP is banned (default: 3)
AUTOBAN_THRESHOLD=3
# Sliding window in minutes to accumulate violations (default: 10)
AUTOBAN_WINDOW_MINUTES=10
# Base duration for the first ban in minutes (default: 30; 2nd: 2h, 3rd+: 24h)
AUTOBAN_BASE_MINUTES=30



