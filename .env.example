PORT=3000
# Optional TMDB API read access token for poster/metadata enrichment
# Fallback to local SQLite catalog runs automatically if omitted
TMDB_TOKEN=

# Secret key for JWT auth tokens (change this to a secure random string)
JWT_SECRET=your_jwt_secret_key_here

# Path to persistent database (defaults to cache/auth.db if omitted)
# AUTH_DB_PATH=/app/cache/auth.db

# Cloudflare Turnstile bot protection (optional; leave empty to disable)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Outgoing proxies (comma-separated HTTP/HTTPS/SOCKS5 proxy URLs).
# A plain URL is a global pool used for everything listed in PROXIED_PROVIDERS.
# Prefix an entry with a provider/CDN name to give it a dedicated pool:
#   PROXIES="tortuga:socks5://user:pass@host:80,ashdi:socks5://user:pass@host:80,socks5://user:pass@fallback:80"
PROXIES=

# Comma-separated list of providers/VODs routed through the global proxy pool
# (e.g. ashdi,tortuga,uaserials or * for all). Per-target entries ignore this list.
PROXIED_PROVIDERS=ashdi,tortuga

# Comma-separated CORS proxies for HLS segments, in priority order (first alive wins)
CORS_PROXIES=https://apx.lme.isroot.in/destination/,https://apn.aartzz.pp.ua/,https://cors.bwa.workers.dev/

# Minimum cooldown time in hours before /v1/refresh/:id can be called for a media item (default: 2)
REFRESH_COOLDOWN_HOURS=2

# UaKinoAX (uakino.ax) provider strategy: auto | web | lampa (default: auto)
# auto tries the web API first (ashdi iframe) and falls back to the lampa proxy re-stream
UAKINO_AX_API=auto

# Optional stable device/session id for the uakino.ax lampa API (param s)
# UAKINO_AX_DEVICE_ID=

# Telegram Bot verification token & username (for 1-account-per-telegram registration)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=uafilms_verif_bot

# Fail2Ban IP Auto-Ban parameters
# Enable or disable auto-ban (default: true)
AUTOBAN_ENABLED=true
# Number of 429 rate limit violations before IP is banned (default: 3)
AUTOBAN_THRESHOLD=3
# Sliding window in minutes to accumulate violations (default: 10)
AUTOBAN_WINDOW_MINUTES=10
# Base duration for the first ban in minutes (default: 30; 2nd: 2h, 3rd+: 24h)
AUTOBAN_BASE_MINUTES=30

# Secret used to sign proxy URLs (segments, embed URLs). Set a long random value in production.
# Falls back to JWT_SECRET when it is set and not the example value.
STREAM_SIGNING_SECRET=

# HLS proxy limits. Values are per client IP.
STREAM_MANIFEST_BURST=120
STREAM_MANIFEST_PER_MINUTE=120
STREAM_MANIFEST_DAILY_QUOTA=10000
STREAM_SEGMENT_BURST=300
STREAM_SEGMENT_PER_MINUTE=1200
STREAM_SEGMENT_DAILY_QUOTA=50000
# Per-IP daily segment bandwidth cap in bytes (default: 50 GiB)
STREAM_SEGMENT_DAILY_BYTES=53687091200
STREAM_SUBTITLE_BURST=30
STREAM_SUBTITLE_PER_MINUTE=60
STREAM_SUBTITLE_DAILY_QUOTA=500
STREAM_PLAY_BURST=30
STREAM_PLAY_PER_MINUTE=30
STREAM_PLAY_DAILY_QUOTA=2000

# Global stream limits across all IPs (protects against IP rotation)
STREAM_GLOBAL_MANIFEST_BURST=2000
STREAM_GLOBAL_MANIFEST_PER_MINUTE=3000
STREAM_GLOBAL_SEGMENT_BURST=3000
STREAM_GLOBAL_SEGMENT_PER_MINUTE=10000
STREAM_GLOBAL_SUBTITLE_BURST=500
STREAM_GLOBAL_SUBTITLE_PER_MINUTE=1000
STREAM_GLOBAL_PLAY_BURST=500
STREAM_GLOBAL_PLAY_PER_MINUTE=1000

# Upstream response caps (bytes)
STREAM_MAX_MANIFEST_BYTES=2097152
STREAM_MAX_SUBTITLE_BYTES=2097152
STREAM_MAX_ASS_BYTES=5242880
STREAM_MAX_SEGMENT_BYTES=33554432
STREAM_MAX_CONCURRENT_SEGMENTS=24

# Playlist cache TTL (seconds). VOD playlists are static; live playlists need a short TTL.
STREAM_PLAYLIST_CACHE_TTL_SECONDS=3600
STREAM_LIVE_PLAYLIST_CACHE_TTL_SECONDS=5

# Require a valid signature on proxy URLs (/master.m3u8, /subs.*, /video.mp4)
# and on /segment URLs (default: true)
STREAM_REQUIRE_SIGNED_URLS=true
STREAM_REQUIRE_SIGNED_SEGMENTS=true

# Allow private/loopback upstream hosts. Keep disabled in production.
STREAM_ALLOW_PRIVATE_HOSTS=false



