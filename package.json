    "url": "https://github.com/uafilms/core/issues"
  },
  "homepage": "https://github.com/uafilms/core#readme",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.2",
    "hono": "^4.13.8",
    "webcrack": "^2.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
